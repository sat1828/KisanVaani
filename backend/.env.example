# =============================================================================
# Server
# =============================================================================
PORT=3001
NODE_ENV=development

# Externally-reachable base URL of THIS backend. Required for:
#   - Twilio webhook signature validation (middleware/auth.ts builds the
#     exact URL Twilio signed and compares it against this + the route).
#   - Building public URLs for uploaded images (api/upload.ts).
# In production this must be the real HTTPS URL Twilio is configured to
# call, e.g. https://api.yourdomain.com — NOT localhost.
PUBLIC_BASE_URL=http://localhost:3001

# =============================================================================
# Database
# =============================================================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/kisanvaani?schema=public"

# Used by docker-compose.yml to set the Postgres container's password.
# No default is provided anywhere in this codebase — you must set a real
# value. Do not reuse this across environments.
DB_PASSWORD=

# =============================================================================
# API authentication
# =============================================================================
# Required by middleware/auth.ts (validateApiKey) to protect /api/chat and
# /api/upload. If left unset, those endpoints accept any request with no
# key check at all — fine for fully local development, never for anything
# internet-reachable. Generate with: openssl rand -hex 32
#
# IMPORTANT TRADEOFF: if your frontend is a public marketing site with an
# embedded demo chat widget (like this project's DemoChat component),
# any API_KEY you bake into the frontend bundle is visible to anyone who
# opens browser devtools — it provides no real protection against a
# determined abuser in that scenario, only against casual/automated
# scanning. For a genuinely public-facing widget, rely primarily on the
# per-identity rate limiting already applied in index.ts and treat
# API_KEY as a soft deterrent, not a security boundary. If you need a
# real boundary (e.g. only your own mobile app should call this, not the
# public website), don't expose this route through the public frontend
# bundle at all — proxy it through a server you control instead.
API_KEY=

# =============================================================================
# Twilio (WhatsApp + Voice webhooks)
# =============================================================================
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_VOICE_NUMBER=+1234567890

# =============================================================================
# OpenAI (Whisper transcription + TTS)
# =============================================================================
OPENAI_API_KEY=your_openai_api_key

# =============================================================================
# Claude (Anthropic) — the actual diagnosis/conversation engine
# =============================================================================
# Without a real key here, the system runs in offline rule-based fallback
# mode (services/claude.ts -> ruleBasedResponse), which is grounded in the
# real seeded DiseaseDB but is NOT a substitute for the real model — it
# cannot reason about novel symptom combinations or hold a real
# conversation. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key
# Override the model used for chat/vision calls. Check
# https://docs.claude.com for current model names before deploying —
# model identifiers change over time and this default may go stale.
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# =============================================================================
# OpenWeatherMap
# =============================================================================
OPENWEATHER_API_KEY=your_openweather_api_key

# =============================================================================
# AGMARKNET / data.gov.in Market Price API
# =============================================================================
# Without this, /api/market and the chat market-price fallback serve a
# small set of clearly-labeled illustrative static prices instead of real
# data. Get a key at https://data.gov.in/
MARKET_API_KEY=your_market_api_key

# =============================================================================
# Contact form (api/contact.ts)
# =============================================================================
# If either of these is unset, contact messages are still saved to the
# database (ContactMessage table) but no notification email is sent — the
# endpoint never fakes success either way.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL="KisanVaani Contact Form <onboarding@resend.dev>"

# =============================================================================
# File uploads (api/upload.ts)
# =============================================================================
# Local disk path for uploaded farmer photos. In production, mount a
# persistent volume here (see docker-compose.yml) or — better — swap this
# endpoint to upload directly to S3/R2/equivalent object storage, since
# local disk doesn't survive container redeploys.
UPLOAD_DIR=./uploads

# Comma-separated hostnames the backend is allowed to fetch images from
# server-side (lib/safeFetch.ts). api.twilio.com is always allowed
# in code. Add your own upload/CDN domain here once you know it, e.g.
# the domain PUBLIC_BASE_URL resolves to.
ALLOWED_IMAGE_HOSTS=

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed frontend origins. In production this
# MUST be your real domain(s) — index.ts refuses to start in production
# if this is unset or "*".
CORS_ORIGIN=http://localhost:5173

# =============================================================================
# JWT (reserved for a future admin panel — not currently used by any route)
# =============================================================================
JWT_SECRET=your_jwt_secret_key_change_in_production
